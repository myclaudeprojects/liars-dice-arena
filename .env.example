# ---- Agents (optional). Without these, seats use built-in heuristic players.
USE_LLM=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # any OpenAI-compatible endpoint works; see src/llm.js

# ---- Money (optional). Without these, an in-memory mock wallet is used.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# ---- Argus Portal #7 (optional). Off unless set. Create Agent still works when this is off.
# Preferred path: ARGUS_MINT_KEY is the key for the house wallet below, and
# Launch with server mint signs as that address. The 100% creator share then
# accrues there. Sign create on Arc stays available; that signer becomes the
# on-chain creator instead. Set the key only in the Render dashboard. Dedicated
# Arc key. Never reuse HOUSE_PRIVATE_KEY or a seat wallet, and never commit
# the value. The key must hold Arc gas. A dev buy is refused on the server
# path. Missing key: the agent stays playable.
ARGUS_MINT_ENABLED=0
# ARGUS_MINT_KEY=
PUBLIC_BASE_URL=https://liars-dice-arena.onrender.com
# House profile prefilled on Launch on Argus. Override without a code change.
# Website and the "Play at" line use LDA_SITE_URL. If it is unset and
# PUBLIC_BASE_URL is already liarsdicearc.app, that host is used instead.
# LDA_SITE_URL=https://liarsdicearc.app
# LDA_X_URL=https://x.com/LiarsDiceArc
# Telegram is left blank unless this is set.
# LDA_TELEGRAM_URL=
# Portal #7 has no fee-recipient argument. This address is the house wallet.
# Server mint uses it as the on-chain creator only when ARGUS_MINT_KEY is that
# wallet. On Portal #7 there is no on-chain split with the spectator.
# ARGUS_CREATOR_WALLET=0x341BB8851Ff8fD9EAE20ea083c2F779e646B8488
# Portal #8 (optional). Unset keeps new mints on Portal #7. Either of these
# lets spectators sign new Portal #8 launches. payoutAddress is the house
# wallet, then ARGUS_MINT_KEY calls setPayoutSplit 5000/5000. The spectator
# pays the 4.50 USDC opening buy. Factory and tokenless backfill still use
# the mint key, which must hold that opening buy plus gas. Existing Portal
# #7 tokens are left as they are.
# ARGUS_PORTAL=8
# ARGUS_PORTAL8_ENABLED=0
# Comma-separated Arc RPCs. Confirmation requires two different hosts.
# Profile market cap uses the same list (first host that answers). Holder
# counts come from the public Arcscan token API. No extra key.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io
# Arena coin ($LIAR), separate from per-agent mints. Unset uses the published
# Liar's Dice Arena contract. LDA_LIAR_BUY_URL, when it is an http(s) URL,
# replaces https://argus.world/token/<address>. The header and Profile open
# that link. This app does not swap.
# LDA_LIAR_TOKEN_ADDRESS=0x47c3D4490C1e8B9ed71464e333AD9D5ce7D20790
# LDA_LIAR_BUY_URL=https://argus.world/token/0x47c3D4490C1e8B9ed71464e333AD9D5ce7D20790

# ---- Pacing
PORT=3000
ANTE=5                      # USDC each agent puts in the pot
BET_WINDOW_MS=20000         # how long spectators have to back an agent
TURN_DELAY_MS=1400          # drama pause between turns
