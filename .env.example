# ---- Agents (optional). Without these, seats use built-in heuristic players.
USE_LLM=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # any OpenAI-compatible endpoint works; see src/llm.js
GROQ_API_KEY=              # cheap LLM; used if Anthropic/OpenAI keys are empty
# LLM_BASE_URL=            # e.g. http://localhost:11434/v1 or https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
ALLOW_LOCAL_AGENTS=        # 1 to allow localhost endpoint agents when RENDER is set

# ---- Money (tips + platform prizes + Argus token buys — not agent antes)
# MOCK=1 forces in-memory wallets even if live keys are present (local previews).
MOCK=
# Self-custodied Arc adapter (live). Preferred until CircleArcWallet is wired.
# Used to record spectator tips to creator wallets and to pay platform prizes.
HOUSE_PRIVATE_KEY=
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_EXPLORER=https://explorer.arc.io
# Circle developer-controlled wallets — adapter is a TODO stub; setting these
# alone will not move funds. See src/wallet.js CircleArcWallet. Default chain
# identifier is Arc mainnet (`ARC`), matching scripts/circle-setup.js.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC
CIRCLE_WALLET_SET_ID=
CIRCLE_USDC_TOKEN_ID=

# ---- Agent tokens (Argus.world)
# Optional operator webhook that receives {type:"agent_token_spec", spec} on
# each registration. Argus has no public create API; do not point this at an
# invented argus.world path. Leave empty to store the spec for a manual launch.
ARGUS_CREATE_URL=
# Canonical site origin for token metadata deep links (no trailing path).
PUBLIC_BASE_URL=https://liarsdicearc.app
# Optional override for custom agent images (default: next to REGISTRY_PATH).
# On Render the disk is /var/data so uploads land in /var/data/avatars.
# AVATAR_DIR=/var/data/avatars

# ---- Pacing (Render production uses the same defaults in render.yaml)
PORT=3000
HOST=0.0.0.0
ANTE_CREDITS=1              # visual/strategic credit ante (1 / 10 / 100)
CROWD_DELAY_MS=8000         # pre-lock influence window (alias: START_DELAY_MS)
MARKET_DELAY_MS=4000        # partner-listing beat after lock, before the deal
PREDICTION_VENUE=placeholder  # placeholder | polymarket | kalshi
# PREDICTION_MARKET_URL=    # if set, panel deep-links instead of "Awaiting partner listing"
TURN_DELAY_MS=1600          # drama pause between turns
TURN_TIMEOUT_MS=6000        # hard cap per agent reply; then a safe legal move
REVEAL_DELAY_MS=3000
MIN_TIP=0.05
TABLE_SIZE=3
TABLE_COUNT=3              # parallel tables in this process (cap 24)
# Optional operator secret for POST /api/treasury (token-tax 25% prize inflows).
# TREASURY_WEBHOOK_SECRET=

# ---- Persistence (on Render these are set to the disk mount)
# STATS_PATH=/var/data/stats.json
# REGISTRY_PATH=/var/data/agents.json
# CREDITS_PATH=/var/data/credits.json
