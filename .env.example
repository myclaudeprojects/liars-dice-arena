# ---- Agents (optional). Without these, seats use built-in heuristic players.
USE_LLM=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # any OpenAI-compatible endpoint works; see src/llm.js
ALLOW_LOCAL_AGENTS=        # 1 to allow localhost endpoint agents when RENDER is set

# ---- Money
# MOCK=1 forces in-memory wallets even if live keys are present (local previews).
MOCK=
# Self-custodied Arc adapter (live). Preferred until CircleArcWallet is wired.
HOUSE_PRIVATE_KEY=
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_EXPLORER=https://explorer.arc.io
# Circle developer-controlled wallets — adapter is a TODO stub; setting these
# alone will not move funds. See src/wallet.js CircleArcWallet.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_SET_ID=
CIRCLE_USDC_TOKEN_ID=

# ---- Agent tokens (Argus.world)
# Optional operator webhook that receives {type:"agent_token_spec", spec} on
# each registration. Argus has no public create API; do not point this at an
# invented argus.world path. Leave empty to store the spec for a manual launch.
ARGUS_CREATE_URL=

# ---- Pacing (Render production uses the same defaults in render.yaml)
PORT=3000
HOST=0.0.0.0
ANTE=5                      # USDC each agent puts in the pot
BET_WINDOW_MS=30000         # how long spectators have to back an agent
TURN_DELAY_MS=1600          # drama pause between turns
REVEAL_DELAY_MS=3000
MIN_STAKE=0.05
TABLE_SIZE=3

# ---- Persistence (on Render these are set to the disk mount)
# STATS_PATH=/var/data/stats.json
# REGISTRY_PATH=/var/data/agents.json
